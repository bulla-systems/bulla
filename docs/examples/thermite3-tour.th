// A tour of the Thermite 3 surface, as a small paging subsystem.
//
// NOT CHECKABLE. Every construct below is proposed rather than shipped — this is
// the surface described in docs/rfcs/, written out in one place so it can be read
// as a language rather than as a pile of individual decisions. `forge check` will
// reject it, and that is expected. The Thermite 2 equivalents that do check live
// in src/ and in the probes cited by docs/language-gaps.md.
//
// Reading order: the effect basis, the state it names, the types, then the
// functions that touch them.

// ---------------------------------------------------------------------------
// The effect basis, spoken in the language.
//
// An effect is an algebraic theory: a signature of operations and the equations
// they satisfy. A label is admissible when it generates a frame condition the
// prover can consume — which is why `random` is a given atom with no equations
// rather than a state effect, and why a PRNG is state after all.
// ---------------------------------------------------------------------------

effect state(r) {
  operation get() -> R
  operation put(v: R) -> ()

  law  get(); get()     == get()
  law  put(a); put(b)   == put(b)
  law  put(a); get()    == put(a); a
}

effect accrues(M) {
  operation add(v: M) -> ()
}

effect panic   { }
effect diverge { }

effect cost(n)     = accrues(nat, +, 0)
effect platform(d) = state(d)

// ---------------------------------------------------------------------------
// Shared state. A `shared` thing is named in the effect row; a `resource` thing
// is not, because ownership already gives exclusivity.
// ---------------------------------------------------------------------------

shared heap:       Heap
shared scheduler:  SchedState
shared shootdown:  Shoot
shared clock:      Instant
shared entropy:    Prng          // a PRNG is state — deterministic, reproducible
shared interrupts: MaskState     // the hardware enable bit

lock sched_lock guards SchedState;
lock frame_lock guards FrameTable after sched_lock;

// ---------------------------------------------------------------------------
// Types. `keeps` is the invariant clause: the struct keeps this true.
// ---------------------------------------------------------------------------

resource struct Grant { base: u64, len: u64, generation: u64 }
  keeps base + len <= MAX_PHYS

struct Shoot { epoch: u64, acked: u64, expected: u64 }
  keeps acked & !expected == 0

enum Walk { Ready { addr: u64 }, Pending { level: u32, index: u64 } }

// A sealed predicate. Consumers reason from `ensures`, not from the body.
opaque spec fn plan_ok(p: Plan) -> bool
  ensures   !result || p.count > 0
  measures  p.count

// ---------------------------------------------------------------------------
// The allocator. A resource is created here and must be consumed exactly once
// on every path that returns.
// ---------------------------------------------------------------------------

fn allocate(pages: u64) -> Result<Grant, u64>
  ! write(heap), cost(12 * pages + 40)
  requires {
    pages > 0;
    pages <= 1024;
  }
  ensures match result {
    Ok(g)  => g.len == pages * 4096 && plan_ok(current_plan()),
    Err(e) => true,
  } by unfold(plan_ok)

fn release(g: Grant) -> ()
  ! write(heap)
  requires  nothing
  ensures   nothing

// Abandonment is an operation, not a hole: counted in the row, and refusable by
// a release rule the way TMK's refuses #[boundary].
fn teardown(g: Grant) -> ()
  ! forgets(heap)
  requires  nothing
  ensures   nothing
{ forget(g) }

// ---------------------------------------------------------------------------
// Lock-free, monotone, shared. The rely is what makes an unlocked read mean
// something: bits are only ever set, so an observation stays a lower bound.
// ---------------------------------------------------------------------------

fn ack(s: &mut Shoot, cpu: u64) -> ()
  ! write(shootdown)
  requires {
    cpu < 64;
    (s.expected >> cpu) & 1 == 1;
  }
  ensures  (final(s).acked >> cpu) & 1 == 1
  interleaves {
    asks {
      final(s).epoch == s.epoch;
      final(s).acked | s.acked == final(s).acked;
    }
    promises {
      final(s).epoch == s.epoch;
      final(s).acked == s.acked | (1 << cpu);
    }
  }

fn complete(s: &Shoot) -> bool
  ! read(shootdown)
  requires  nothing
  ensures   result == (s.acked == s.expected)
  interleaves {
    asks      final(s).acked | s.acked == final(s).acked;
    promises  final(s).acked == s.acked;
  }

interleaves shootdown { ack, complete }

// ---------------------------------------------------------------------------
// Serialised, under a lock. The invariant may be false inside the section and
// must hold at its edges. A function holds at most one lock unless the locks
// are ordered with `after`.
// ---------------------------------------------------------------------------

fn enqueue(t: TaskId) -> ()
  ! owns(interrupts), owns(sched_lock), write(scheduler)
  requires  t < MAX_TASKS
  ensures   nothing
{
  holding interrupts {
    holding sched_lock {
      // SchedState's `keeps` may be false here
    }
  }
}

// ---------------------------------------------------------------------------
// Interrupts. A handler is the environment, its atomicity is a platform
// assumption, and masking is a lock against it.
// ---------------------------------------------------------------------------

fn timer_isr() -> ()
  ! owns(sched_lock), write(scheduler), read(clock)
  requires  nothing
  ensures   nothing
  interleaves {
    asks      final(scheduler) == scheduler;   // atomic — PLATFORM ASSUMPTION
    promises  final(scheduler).ticks == scheduler.ticks + 1;
  }
{ holding sched_lock { } }

handlers { timer_isr at 1 }

// ---------------------------------------------------------------------------
// Protocols. A sequence of turns, each labelled with whose turn it is, ending
// in `end`. An endpoint is a path to a role, and it is a resource.
// ---------------------------------------------------------------------------

protocol PageRequest {
  User     { op: u32, count: u64 },
  Provider { status: u32, base: u64 },
  end
}

protocol PageStream {
  User     { op: u32, count: u64 },
  Provider { status: u32, base: u64 },
  repeat | end
}

fn pager(c: PageRequest::Provider) -> ()
  ! blocks, write(heap)
  requires  nothing
  ensures   nothing

fn app(c: PageRequest::User) -> ()
  ! blocks
  requires  nothing
  ensures   nothing

// ---------------------------------------------------------------------------
// An operation that does not finish in one step. The continuation is data the
// caller holds, and the postcondition carries a measure across calls.
// ---------------------------------------------------------------------------

fn advance(s: WalkState) -> Walk
  ! pure
  requires  s.level <= 4
  ensures match result {
    Walk::Ready { addr }           => s.level == 0,
    Walk::Pending { level, index } => level < s.level,
  }

// ---------------------------------------------------------------------------
// Durable state. `survives` is the crash-time analogue of `ensures`: what holds
// if execution stops at any point inside.
// ---------------------------------------------------------------------------

fn commit(j: &mut Journal, b: Block) -> ()
  ! write(disk), panic
  requires {
    j.open;
    b.len <= MAX_BLOCK;
  }
  ensures   final(j).committed == j.committed + 1
  survives {
    final(j).recoverable;
    final(j).committed == j.committed
      || final(j).committed == j.committed + 1;
  }

// ---------------------------------------------------------------------------
// A loop keeps its invariant and measures its way down. A loop that never ends
// says so, and pays for it: `diverge` drops the item from L3 to L1.
// ---------------------------------------------------------------------------

fn drain(n: u64) -> u64
  ! pure
  requires  n <= 64
  ensures   result == 0
{
  let mut i: u64 = n;
  while i > 0
    keeps     i <= n
    measures  i
  {
    i = i - 1;
  }
  i
}

fn idle() -> ()
  ! diverge, read(clock)
  requires  nothing
  ensures   nothing

// ---------------------------------------------------------------------------
// Randomness, stipulated. `state(entropy)` is a PRNG — deterministic and
// reproducible. `random` is the claim that nothing is known about the value,
// which is sound and weaker, and it is what makes a program non-reproducible.
// ---------------------------------------------------------------------------

fn next_token() -> u64
  ! write(entropy)
  requires  nothing
  ensures   nothing

fn sample_nonce() -> u64
  ! random
  requires  nothing
  ensures   nothing
